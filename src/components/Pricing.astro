---
import { waLinks } from '../lib/site';
import { ui, type Lang } from '../i18n/ui';
import { money, rich } from '../lib/i18n';
import Mark from './Mark.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = ui[lang].pricing;
const p = t.promo;
const { demo: WA_DEMO, promo: WA_PROMO } = waLinks(lang);
---

<section id="precios" class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:py-32">
  <div aria-hidden="true" class="pointer-events-none absolute -right-20 top-1/4 -z-0 size-[480px] rounded-full bg-volt/15 blur-[130px]"></div>
  <Mark kind="pin" class="pointer-events-none absolute -left-6 top-10 hidden h-64 -rotate-[14deg] text-white/[0.04] md:block" />
  <div class="reveal max-w-3xl">
    <p class="eyebrow mb-4">{t.eyebrow}</p>
    <h2 class="h2">{t.h2}</h2>
    <p class="mt-5 text-lg text-mute">{t.sub}</p>
    <p data-money-note hidden class="mt-3 text-sm text-volt">{t.note}</p>
  </div>

  <div class="mt-14 grid gap-5 lg:grid-cols-2">
    <article class="reveal panel panel-glow panel-green flex flex-col p-8 sm:p-10">
      <p class="font-display text-xl font-bold uppercase tracking-wider text-mute">{t.plan}</p>
      <p class="mt-4 flex items-baseline gap-2">
        <span class="font-display text-7xl font-extrabold leading-none sm:text-8xl" set:html={money(240000, lang)} />
        <span class="text-mute">{t.perMonth}</span>
      </p>
      <ul class="mt-8 space-y-3 text-[15px]">
        {
          t.includes.map((x) => (
            <li class="flex gap-3">
              <span class="mt-0.5 text-volt" aria-hidden="true">✓</span>
              {x}
            </li>
          ))
        }
      </ul>
      <div class="mt-8 border-t border-white/10 pt-6">
        <p class="font-display text-lg font-semibold uppercase tracking-[0.14em] text-volt">{t.unlimitedTitle}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            t.unlimited.map((x) => (
              <li class="rounded-full border border-volt/40 bg-volt/10 px-4 py-1.5 text-sm font-semibold">
                {x} <span class="text-volt">{t.unlimitedSuffix}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="mt-6 border-t border-white/10 pt-6">
        <p class="font-display text-lg font-semibold uppercase tracking-[0.14em] text-volt">
          {t.customTitle}
        </p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {t.custom.map((x) => <li class="rounded-full border border-white/15 px-4 py-1.5 text-sm">{x}</li>)}
        </ul>
      </div>
      <p class="mt-8 border-t border-white/10 pt-6 text-sm text-mute" set:html={rich(t.terms, lang)} />
      <div class="mt-auto flex flex-col gap-3 pt-8 sm:flex-row">
        <a href={WA_DEMO} target="_blank" rel="noopener" class="btn btn-volt">{t.demo}</a>
        <button type="button" disabled class="btn btn-ghost cursor-not-allowed opacity-50 hover:!border-white/20 hover:!text-bone">
          {t.payOnline}
        </button>
      </div>
    </article>

    <article
      id="promo-card"
      class="reveal relative flex flex-col overflow-hidden rounded-3xl bg-royal p-8 text-bone shadow-[0_30px_80px_-30px_rgba(197,139,255,0.45)] sm:p-10"
      style="background-image:radial-gradient(500px 400px at 0% 0%,rgba(255,255,255,.22),transparent 60%),linear-gradient(160deg,#6002ab,#370063)"
    >
      <Mark kind="arch" class="pointer-events-none absolute -bottom-8 -right-12 w-72 text-white/10" />
      <span class="absolute right-6 top-6 rounded-full bg-ink px-3 py-1 text-xs font-bold uppercase tracking-wider text-volt">
        {p.badge}
      </span>
      <p class="font-display text-xl font-bold uppercase tracking-wider opacity-70">{p.kicker}</p>
      <h3 class="mt-2 text-5xl sm:text-6xl">{p.title[0]}<br />{p.title[1]}</h3>

      <div class="mt-8">
        <p class="text-sm font-bold uppercase tracking-wider">{p.first6}</p>
        <p class="flex flex-wrap items-baseline gap-x-3">
          <span class="font-display text-[5.5rem] font-extrabold leading-[0.9] sm:text-[6.8rem]" set:html={money(120000, lang)} />
          <span class="font-display text-3xl font-bold uppercase">{p.month}</span>
        </p>
        <p class="mt-1 text-[15px] font-medium" set:html={rich(p.instead.replace('{240000}', '<s class="opacity-70">{240000}</s>'), lang)} />
      </div>

      <ol class="mt-8 grid grid-cols-6 gap-1.5 sm:gap-2" aria-label={p.monthsAria}>
        {
          [1, 2, 3, 4, 5, 6].map((m) => (
            <li
              class:list={[
                'rounded-xl py-3 text-center',
                m <= 3 ? 'bg-ink text-bone' : 'border-2 border-dashed border-white/50',
              ]}
            >
              <span class="block text-[10px] font-semibold uppercase tracking-wider opacity-70">{p.monthLabel}</span>
              <span class="block font-display text-3xl font-extrabold leading-none">{m}</span>
              <span class:list={['mt-1 block text-[10px] font-bold uppercase tracking-wider', m <= 3 ? 'text-volt' : '']}>
                {m <= 3 ? p.pay : p.free}
              </span>
            </li>
          ))
        }
      </ol>

      <div class="mt-4 flex items-center justify-between gap-4 rounded-2xl bg-ink p-5 text-bone">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-mute">{p.youPay}</p>
          <p class="font-display text-4xl font-extrabold" set:html={money(720000, lang)} />
          <p class="text-xs text-mute" set:html={rich(p.insteadOf, lang)} />
        </div>
        <div class="text-right">
          <p class="text-xs font-semibold uppercase tracking-wider text-mute">{p.youSave}</p>
          <p class="font-display text-4xl font-extrabold text-volt" set:html={money(720000, lang)} />
          <p class="text-xs text-mute">{p.fifty}</p>
        </div>
      </div>

      <p class="mt-5 text-sm font-medium leading-relaxed" set:html={rich(p.contract, lang)} />
      <div class="mt-auto pt-6">
        <a href={WA_PROMO} target="_blank" rel="noopener" class="btn bg-ink text-volt hover:-translate-y-0.5">
          {p.cta}
        </a>
      </div>
    </article>
  </div>
</section>

<script>
  import { PROMO_END } from '../lib/site';
  if (Date.now() > new Date(PROMO_END).getTime()) document.getElementById('promo-card')?.remove();
</script>

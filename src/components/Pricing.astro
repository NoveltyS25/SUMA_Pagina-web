---
import { waLinks } from '../lib/site';
import { ui, type Lang } from '../i18n/ui';
import { money, rich } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = ui[lang].pricing;
const p = t.promo;
const wa = waLinks(lang);
const planLinks = [wa.plan1, wa.plan6, wa.plan12];
---

<section id="precios" class="hm-sec hm-gray">
  <div class="hm-wrap">
    <header class="hm-head reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="h2">{t.h2[0]}<span class="hm-accent">{t.h2[1]}</span></h2>
      <p class="hm-lead">{t.sub}</p>
      <p data-money-note hidden class="hm-small">{t.note}</p>
    </header>

    <article id="promo-card" class="hm-promo reveal">
      <div>
        <span class="hm-badge">{p.badge}</span>
        <h3>{p.title[0]} {p.title[1]}</h3>
        <p class="hm-promo-price"><b set:html={money(120000, lang)} /><span>{p.month}</span> <s set:html={rich('{240000}', lang)} /></p>
        <p class="hm-promo-first">{p.first6}</p>
        <ol class="hm-months" aria-label={p.monthsAria}>
          {[1, 2, 3, 4, 5, 6].map((m) => <li class:list={[m <= 3 ? 'is-pay' : 'is-free']}><b>{m}</b><span>{m <= 3 ? p.pay : p.free}</span></li>)}
        </ol>
      </div>
      <div class="hm-promo-cta">
        <a href={wa.promo} target="_blank" rel="noopener" class="btn btn-light">{p.cta}</a>
        <p class="hm-small" set:html={rich(p.contract, lang)} />
      </div>
    </article>

    <div class="hm-plans">
      {
        t.plans.map((plan, i) => (
          <article class:list={['hm-plan reveal', plan.highlight && 'is-hi']} style={`--d:${i * 0.08}s`}>
            <h3>{plan.name}</h3>
            <p class="hm-price"><b set:html={money(plan.price, lang)} /><span>{t.perMonth}</span></p>
            <p class="hm-plan-note">{plan.commitment}</p>
            {plan.save ? <p class="hm-save" set:html={rich(plan.save, lang)} /> : <p class="hm-save hm-save-empty" aria-hidden="true">&nbsp;</p>}
            <a href={planLinks[i]} target="_blank" rel="noopener" class:list={['btn', plan.highlight ? 'btn-light' : 'btn-volt']}>{plan.cta}</a>
          </article>
        ))
      }
    </div>

    <ul class="hm-incl reveal">
      {t.includes.map((x) => <li><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{x}</li>)}
    </ul>
    <p class="hm-small hm-center" set:html={rich(t.terms, lang)} />
  </div>
</section>

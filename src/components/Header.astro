---
import { waLinks } from '../lib/site';
import { ui, LANGS, homePath, type Lang } from '../i18n/ui';
import { homeLink } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = ui[lang].header;
const links = [...t.nav.map(([label, hash]) => [label, homeLink(lang, hash)]), [t.guide, '/como-fidelizar-clientes']];
---

<div id="promo-bar" class="hm-promo-bar">
  <a href={homeLink(lang, '#precios')}>{t.promoBar} <span aria-hidden="true">→</span></a>
</div>

<header class="hm-header">
  <div class="hm-wrap hm-header-in">
    <a href={homePath(lang)} aria-label={t.homeAria} class="hm-logo">
      <img src="/logos/suma-negro-sm.webp" alt="SUMA" width="120" height="70" />
    </a>
    <nav class="hm-nav" aria-label={t.navAria}>
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <div class="hm-header-r">
      <div class="hm-lang" role="group" aria-label={t.langAria}>
        {
          LANGS.map((l) => (
            <a href={homePath(l)} hreflang={ui[l].htmlLang} data-lang={l} lang={ui[l].htmlLang} aria-current={l === lang ? 'true' : undefined} title={ui[l].langName}>
              {l}
            </a>
          ))
        }
      </div>
      <a href={waLinks(lang).contact} target="_blank" rel="noopener" class="btn btn-volt hm-wa">{t.whatsapp}</a>
    </div>
  </div>
</header>

<script>
  // Recordar el idioma que eligió la persona
  document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((a) =>
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('suma-lang', a.dataset.lang ?? 'es');
      } catch {}
    }),
  );
</script>

---
import { waLinks } from '../lib/site';
import { ui, type Lang } from '../i18n/ui';
import { homeLink } from '../lib/i18n';
import WalletCard from './WalletCard.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = ui[lang].hero;
const wa = waLinks(lang);
---

<section class="hm-hero" aria-labelledby="h1">
  <div class="hm-wrap hm-hero-grid">
    <div class="hm-hero-copy">
      <h1 id="h1" class="hm-h1">{t.h1[0]}<span class="hm-accent">{t.h1[1]}</span>{t.h1[2]}</h1>
      <p class="hm-lead">{t.sub}</p>
      <div class="hm-cta">
        <a href={homeLink(lang, '#precios')} class="btn btn-volt">{t.cta1}</a>
        <a href={wa.demo} target="_blank" rel="noopener" class="btn btn-ghost">{t.cta2}</a>
      </div>
      <ul class="hm-chips">
        {t.chips.map((c) => <li>{c}</li>)}
      </ul>
    </div>
    <div class="hm-fan" aria-hidden="true">
      <WalletCard biz="alma" lang={lang} class="hm-fan-l" />
      <WalletCard biz="elr" lang={lang} class="hm-fan-r" />
      <WalletCard biz="cupa" lang={lang} eager class="hm-fan-c" />
    </div>
  </div>
</section>

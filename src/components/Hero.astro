---
import { WA_CONTACT, WA_DEMO } from '../lib/site';
import Mark from './Mark.astro';
import Sparkle from './Sparkle.astro';
const stamps = Array.from({ length: 10 }, (_, i) => i < 6);

// Código QR decorativo (no escaneable): 3 marcadores de esquina + celdas pseudoaleatorias fijas.
const qr: [number, number][] = [];
const finder = (ox: number, oy: number) => {
  for (let y = 0; y < 7; y++)
    for (let x = 0; x < 7; x++) {
      const edge = x === 0 || y === 0 || x === 6 || y === 6;
      const core = x >= 2 && x <= 4 && y >= 2 && y <= 4;
      if (edge || core) qr.push([ox + x, oy + y]);
    }
};
finder(0, 0);
finder(14, 0);
finder(0, 14);
let seed = 7;
for (let y = 0; y < 21; y++)
  for (let x = 0; x < 21; x++) {
    const inFinder = (x < 8 && y < 8) || (x > 12 && y < 8) || (x < 8 && y > 12);
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    if (!inFinder && seed % 100 < 48) qr.push([x, y]);
  }
---

<section class="relative overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-40 top-0 h-[640px] w-[640px] rounded-full bg-royal/50 blur-[140px]"
  >
  </div>
  <Mark kind="arch" class="pointer-events-none absolute -left-24 bottom-0 hidden w-[520px] text-volt/[0.05] lg:block" />
  <svg aria-hidden="true" class="pointer-events-none absolute inset-0 hidden h-full w-full lg:block" viewBox="0 0 1440 800" preserveAspectRatio="none" fill="none">
    <path d="M-20 560C220 760 420 700 560 520S900 120 1180 190s300 260 300 260" stroke="#c58bff" stroke-opacity=".3" stroke-width="1.5" />
    <path d="M-20 600C240 800 460 760 620 570S950 170 1210 230s250 230 250 230" stroke="#c58bff" stroke-opacity=".12" stroke-width="1" />
  </svg>
  <Sparkle class="twinkle pointer-events-none absolute left-[46%] top-24 size-7 text-volt" />
  <Sparkle class="twinkle pointer-events-none absolute left-[2%] top-[92%] size-5 text-volt/70" />
  <Sparkle class="twinkle pointer-events-none absolute bottom-24 left-[52%] size-9 text-volt" />
  <Sparkle class="twinkle pointer-events-none absolute right-[4%] top-28 size-6 text-volt/80" />
  <div
    aria-hidden="true"
    class="absolute inset-0 opacity-[0.07] [background-image:radial-gradient(#fff_1px,transparent_1px)] [background-size:28px_28px] [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"
  >
  </div>

  <div
    class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pb-20 pt-14 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:pb-28 lg:pt-20"
  >
    <div>
      <p class="eyebrow mb-5">El cartón de sellos ya murió</p>
      <h1 class="text-[3.6rem] sm:text-[5.2rem] lg:text-[6.4rem]">
        Tarjetas de fidelización <span class="text-volt">digital</span>
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-mute sm:text-xl">
        La tarjeta de sellos vive en el Apple Wallet y Google Wallet de tus clientes y se conecta a tu
        caja. Sin apps, sin cartón.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={WA_DEMO} target="_blank" rel="noopener" class="btn btn-volt">Agendar una demo</a>
        <a href={WA_CONTACT} target="_blank" rel="noopener" class="btn btn-ghost">Escribir por WhatsApp</a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-sm text-mute">
        {
          ['Sin apps que descargar', 'Se inscriben en 30 segundos', 'Conectada a tu caja'].map((t) => (
            <li class="flex items-center gap-2">
              <span class="size-1.5 rounded-full bg-volt" />
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Maqueta del celular con la vista de Wallet (reemplazar por capturas reales cuando existan) -->
    <div class="relative mx-auto w-full max-w-[340px]">
      <div
        aria-hidden="true"
        class="absolute left-1/2 top-1/2 size-[440px] -translate-x-[45%] -translate-y-[48%] rounded-full bg-gradient-to-br from-royal via-royal to-forest shadow-[0_0_140px_30px_rgba(96,2,171,0.5)] sm:size-[520px]"
      >
      </div>
      <div
        class="floaty relative mx-auto h-[610px] w-[296px] rounded-[50px] border-[8px] border-[#f4f4f6] bg-[#f2f2f7] shadow-[0_0_0_2px_rgba(0,0,0,0.25),0_50px_100px_-20px_rgba(0,0,0,0.75),0_0_80px_-10px_rgba(255,255,255,0.25)]"
      >
        <!-- Isla dinámica -->
        <div class="absolute left-1/2 top-2.5 z-10 h-[22px] w-[84px] -translate-x-1/2 rounded-full bg-black"></div>
        <div class="flex items-center justify-between px-6 pt-3.5 text-[11px] font-bold text-black">
          <span>9:41</span>
          <span class="flex items-center gap-1" aria-hidden="true">
            <span class="h-2 w-3 rounded-sm bg-black/80"></span>
            <span class="h-2.5 w-5 rounded-[3px] border border-black/70"></span>
          </span>
        </div>

        <!-- Tarjeta de Wallet -->
        <div class="relative mx-3 mt-5 overflow-hidden rounded-2xl p-3.5 text-white shadow-[0_18px_30px_-12px_rgba(0,0,0,0.55)]" style="background:radial-gradient(240px 140px at 100% 0%,rgba(197,139,255,0.35),transparent 70%),linear-gradient(165deg,#2a0447 0%,#1a012e 100%)">
          <div class="absolute inset-x-0 top-[34%] h-[18%] bg-gradient-to-b from-transparent via-white/[0.08] to-transparent"></div>
          <div class="relative flex items-start justify-between">
            <span class="flex size-11 items-center justify-center rounded-full border border-dashed border-volt/70 text-[8px] font-bold uppercase leading-tight text-volt">
              Tu<br />logo
            </span>
            <div class="text-right">
              <p class="font-mono text-[9px] font-bold tracking-widest text-white/80">SELLOS</p>
              <p class="font-mono text-sm font-bold tracking-wider">6 DE 10</p>
            </div>
          </div>
          <div class="relative mt-4 grid grid-cols-5 gap-2">
            {
              stamps.map((on, i) =>
                i === 9 ? (
                  <span class="flex aspect-square items-center justify-center rounded-full border border-dashed border-white/40 text-volt">
                    <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1" /><path d="M12 8v13M5 12v9h14v-9M7.5 8a2.5 2.5 0 1 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 1 1 0 5" /></svg>
                  </span>
                ) : (
                  <span
                    class:list={[
                      'flex aspect-square items-center justify-center rounded-full',
                      on ? 'bg-volt shadow-[0_0_12px_rgba(197,139,255,0.6)]' : 'border border-dashed border-white/40',
                    ]}
                  >
                    {on && (
                      <svg viewBox="0 0 24 24" class="size-3.5 text-ink" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                    )}
                  </span>
                ),
              )
            }
          </div>
          <div class="relative mt-4 flex justify-between">
            <div>
              <p class="font-mono text-[8px] font-bold tracking-widest text-white/60">CLIENTE</p>
              <p class="text-[13px]">Laura Gómez</p>
            </div>
            <div class="text-right">
              <p class="font-mono text-[8px] font-bold tracking-widest text-white/60">CATEGORÍA</p>
              <p class="text-[13px] text-volt">Miembro</p>
            </div>
          </div>
          <div class="relative mx-auto mt-4 w-[104px] rounded-md bg-white p-2">
            <svg viewBox="0 0 21 21" class="block w-full" shape-rendering="crispEdges" aria-hidden="true">
              {
                qr.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill="#1a012e" />)
              }
            </svg>
          </div>
        </div>
        <div class="mt-3 flex justify-center gap-1.5" aria-hidden="true">
          <span class="size-1.5 rounded-full bg-black"></span>
          <span class="size-1.5 rounded-full bg-black/25"></span>
        </div>

        <!-- Otras tarjetas asomando (sin marcas) -->
        <div class="absolute inset-x-0 bottom-0 h-[96px] overflow-hidden rounded-b-[42px]" aria-hidden="true">
          <div class="absolute inset-x-6 top-0 h-14 rounded-t-[22px] bg-forest"></div>
          <div class="absolute inset-x-3 top-3 h-14 rounded-t-[22px] bg-[#2a0447]"></div>
          <div class="absolute inset-x-0 top-6 h-20 rounded-t-[22px] bg-gradient-to-b from-volt to-[#370063]"></div>
        </div>
      </div>

      <div
        class="absolute -left-4 bottom-16 rotate-[-6deg] rounded-2xl border border-white/10 panel !rounded-2xl px-4 py-3 sm:-left-10"
      >
        <p class="font-display text-3xl font-extrabold leading-none text-volt">+1</p>
        <p class="text-xs text-mute">sello al instante</p>
      </div>
      <div
        class="absolute -right-2 bottom-28 rotate-[5deg] rounded-2xl border border-white/10 panel !rounded-2xl px-4 py-3 sm:-right-8"
      >
        <p class="text-xs text-mute">Cliente nuevo</p>
        <p class="text-sm font-bold">Registrado en 30 s</p>
      </div>
    </div>
  </div>
</section>

---
import { WA_CONTACT, WA_DEMO } from '../lib/site';
const stamps = Array.from({ length: 10 }, (_, i) => i < 6);
---

<section class="relative overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-40 top-0 h-[640px] w-[640px] rounded-full bg-volt/20 blur-[140px]"
  >
  </div>
  <div
    aria-hidden="true"
    class="absolute inset-0 opacity-[0.07] [background-image:radial-gradient(#fff_1px,transparent_1px)] [background-size:28px_28px] [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"
  >
  </div>

  <div
    class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pb-20 pt-14 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:pb-28 lg:pt-20"
  >
    <div>
      <p class="eyebrow mb-5">Fidelización digital</p>
      <h1 class="text-[4.2rem] sm:text-[6rem] lg:text-[7.5rem]">
        El cartón de sellos <span class="text-volt">ya murió.</span>
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-mute sm:text-xl">
        SUMA pone la tarjeta de fidelización en el celular de tus clientes, conectada a tu caja.
        Más visitas, datos reales y cero cambios en tu operación.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={WA_DEMO} target="_blank" rel="noopener" class="btn btn-volt">Agendar una demo</a>
        <a href={WA_CONTACT} target="_blank" rel="noopener" class="btn btn-ghost">
          Escribir por WhatsApp
        </a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-sm text-mute">
        {
          ['Apple y Google Wallet', 'Sin apps que descargar', 'Inscripción en 30 segundos'].map(
            (t) => (
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-volt" />
                {t}
              </li>
            ),
          )
        }
      </ul>
    </div>

    <!-- Maqueta del celular (reemplazar por capturas reales cuando existan) -->
    <div class="relative mx-auto w-full max-w-[340px]">
      <div
        class="floaty relative mx-auto h-[600px] w-[290px] rounded-[46px] border-[9px] border-[#1d1d21] bg-[#0f0f11] p-4 shadow-[0_40px_90px_-20px_rgba(0,224,208,0.25)]"
      >
        <div class="mx-auto mb-4 h-5 w-24 rounded-full bg-black"></div>
        <p class="mb-3 px-1 font-display text-2xl font-semibold uppercase tracking-wide">Wallet</p>

        <div class="rounded-3xl bg-volt p-4 text-ink shadow-lg">
          <div class="flex items-start justify-between">
            <div>
              <p class="font-display text-2xl font-extrabold uppercase leading-none">Tu negocio</p>
              <p class="mt-1 text-xs font-medium opacity-70">Tarjeta de cliente</p>
            </div>
            <span class="rounded-full bg-ink px-2.5 py-1 text-[10px] font-bold text-volt">
              TU LOGO
            </span>
          </div>
          <div class="mt-5 grid grid-cols-5 gap-2">
            {
              stamps.map((on) => (
                <span
                  class:list={[
                    'aspect-square rounded-full border-2 border-ink/80',
                    on ? 'bg-ink' : 'bg-transparent',
                  ]}
                />
              ))
            }
          </div>
          <div class="mt-5 flex items-end justify-between">
            <div>
              <p class="text-[10px] font-medium opacity-60">Miembro</p>
              <p class="text-sm font-bold">Laura Gómez</p>
            </div>
            <span class="rounded-full bg-ink/90 px-3 py-1 text-[11px] font-bold text-volt">MI QR</span>
          </div>
        </div>

        <div class="mt-4 rounded-2xl border border-white/10 bg-ink-2 p-3.5">
          <p class="text-[10px] font-semibold uppercase tracking-wider text-volt">SUMA · ahora</p>
          <p class="mt-1 text-sm font-semibold">¡Nuevo sello! Llevas 6 de 10</p>
          <p class="text-xs text-mute">Te faltan 4 visitas para tu premio.</p>
        </div>
        <div class="mt-3 rounded-2xl border border-white/5 bg-ink-2/60 p-3.5 opacity-60">
          <p class="text-xs text-mute">Otras tarjetas</p>
          <div class="mt-2 h-8 rounded-lg bg-white/5"></div>
        </div>
      </div>

      <div
        class="absolute -left-4 bottom-16 rotate-[-6deg] rounded-2xl border border-white/10 bg-ink-2/95 px-4 py-3 shadow-xl sm:-left-10"
      >
        <p class="font-display text-3xl font-extrabold leading-none text-volt">+1</p>
        <p class="text-xs text-mute">sello al instante</p>
      </div>
      <div
        class="absolute -right-2 bottom-28 rotate-[5deg] rounded-2xl border border-white/10 bg-ink-2/95 px-4 py-3 shadow-xl sm:-right-8"
      >
        <p class="text-xs text-mute">Cliente nuevo</p>
        <p class="text-sm font-bold">Registrado en 30 s</p>
      </div>
    </div>
  </div>
</section>

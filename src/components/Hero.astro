---
import { WA_CONTACT, WA_DEMO } from '../lib/site';
import Mark from './Mark.astro';
import Sparkle from './Sparkle.astro';
---

<section class="relative overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-40 top-0 h-[640px] w-[640px] rounded-full bg-royal/50 blur-[140px]"
  >
  </div>
  <Mark kind="arch" class="pointer-events-none absolute -left-24 bottom-0 hidden w-[520px] text-volt/[0.05] lg:block" />
  <svg aria-hidden="true" class="pointer-events-none absolute inset-0 hidden h-full w-full lg:block" viewBox="0 0 1440 800" preserveAspectRatio="none" fill="none">
    <path d="M-20 560C220 760 420 700 560 520S900 120 1180 190s300 260 300 260" stroke="#c58bff" stroke-opacity=".3" stroke-width="1.5" />
    <path d="M-20 600C240 800 460 760 620 570S950 170 1210 230s250 230 250 230" stroke="#c58bff" stroke-opacity=".12" stroke-width="1" />
  </svg>
  <Sparkle class="twinkle pointer-events-none absolute left-[46%] top-24 size-7 text-volt" />
  <Sparkle class="twinkle pointer-events-none absolute left-[2%] top-[92%] size-5 text-volt/70" />
  <Sparkle class="twinkle pointer-events-none absolute bottom-24 left-[52%] size-9 text-volt" />
  <Sparkle class="twinkle pointer-events-none absolute right-[4%] top-28 size-6 text-volt/80" />
  <div
    aria-hidden="true"
    class="absolute inset-0 opacity-[0.07] [background-image:radial-gradient(#fff_1px,transparent_1px)] [background-size:28px_28px] [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"
  >
  </div>

  <div
    class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pb-20 pt-14 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:pb-28 lg:pt-20"
  >
    <div>
      <p class="eyebrow mb-5">El cartón de sellos ya murió</p>
      <h1 class="text-[3.6rem] sm:text-[5.2rem] lg:text-[6.4rem]">
        Tarjetas de fidelización <span class="text-volt">digital</span>
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-mute sm:text-xl">
        La tarjeta de sellos vive en el Apple Wallet y Google Wallet de tus clientes y se conecta a tu
        caja. Sin apps, sin cartón.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={WA_DEMO} target="_blank" rel="noopener" class="btn btn-volt">Agendar una demo</a>
        <a href={WA_CONTACT} target="_blank" rel="noopener" class="btn btn-ghost">Escribir por WhatsApp</a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-sm text-mute">
        {
          ['Sin apps que descargar', 'Se inscriben en 30 segundos', 'Conectada a tu caja'].map((t) => (
            <li class="flex items-center gap-2">
              <span class="size-1.5 rounded-full bg-volt" />
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-[340px]">
      <div
        aria-hidden="true"
        class="absolute left-1/2 top-1/2 size-[420px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-br from-royal via-royal to-forest shadow-[0_0_140px_30px_rgba(96,2,171,0.5)] sm:size-[500px]"
      >
      </div>
      <img
        src="/img/tarjeta-cupa.webp"
        alt="Tarjeta de fidelización digital con sellos de Cupá Pastry & Coffee en Apple Wallet"
        width="536"
        height="750"
        fetchpriority="high"
        class="floaty relative mx-auto w-[280px] drop-shadow-[0_40px_50px_rgba(0,0,0,0.55)] sm:w-[320px]"
      />
      <div class="absolute -left-2 bottom-14 rotate-[-6deg] rounded-2xl border border-white/10 panel !rounded-2xl px-4 py-3 sm:-left-10">
        <p class="font-display text-3xl font-extrabold leading-none text-volt">+1</p>
        <p class="text-xs text-mute">sello al instante</p>
      </div>
      <div class="absolute -right-2 top-10 rotate-[5deg] rounded-2xl border border-white/10 panel !rounded-2xl px-4 py-3 sm:-right-8">
        <p class="text-xs text-mute">Tarjeta real de</p>
        <p class="text-sm font-bold">Cupá Pastry &amp; Coffee</p>
      </div>
    </div>
  </div>
</section>

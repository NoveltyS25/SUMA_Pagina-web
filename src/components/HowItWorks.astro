---
const steps = [
  ['01', 'Escanea', 'El cliente escanea el QR de la mesa o el mostrador.'],
  ['02', 'Regístrate', 'Se inscribe en 30 segundos y guarda la tarjeta en su Wallet.'],
  ['03', 'Cobra igual', 'Tu equipo cobra como siempre y pide la cédula. Nos conectamos a tu caja.'],
  ['04', 'Suma sellos', 'El sello llega solo a su celular, con aviso al instante.'],
];
---

<section id="como-funciona" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:py-32">
  <div class="reveal max-w-3xl">
    <p class="eyebrow mb-4">Cómo funciona</p>
    <h2 class="h2">Cuatro pasos. Cero fricción.</h2>
  </div>

  <ol class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      steps.map(([n, title, text], i) => (
        <li
          class="reveal group rounded-3xl border border-white/10 bg-ink-2 p-7 transition hover:border-volt/60"
          style={`transition-delay:${i * 80}ms`}
        >
          <span class="font-display text-6xl font-extrabold leading-none text-volt/90">{n}</span>
          <h3 class="mt-6 text-3xl">{title}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-mute">{text}</p>
        </li>
      ))
    }
  </ol>
</section>

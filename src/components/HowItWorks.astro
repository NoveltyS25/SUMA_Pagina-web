---
import Mark from './Mark.astro';
const steps = [
  ['01', 'Escanea', 'Escanea el QR del local.'],
  ['02', 'Regístrate', '30 segundos y la guarda en su Wallet.'],
  ['03', 'Cobra igual', 'Como siempre. Pides la cédula.'],
  ['04', 'Suma sellos', 'Llega solo a su celular.'],
];
---

<section id="como-funciona" class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:py-32">
  <Mark kind="pin" class="pointer-events-none absolute -right-4 top-16 hidden h-72 rotate-[14deg] text-white/[0.04] md:block" />
  <div class="reveal max-w-3xl">
    <p class="eyebrow mb-4">Cómo funciona</p>
    <h2 class="h2">Cuatro pasos. Cero fricción.</h2>
  </div>

  <ol class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      steps.map(([n, title, text], i) => (
        <li
          class:list={[
            'reveal group p-7 transition',
            i === 1
              ? 'relative overflow-hidden rounded-3xl text-bone shadow-[0_30px_80px_-30px_rgba(197,139,255,0.55)] lg:-translate-y-4'
              : 'panel hover:border-volt/60 hover:shadow-[0_0_50px_-12px_rgba(197,139,255,0.4)]',
          ]}
          style={`transition-delay:${i * 80}ms;${i === 1 ? 'background-image:radial-gradient(500px 400px at 0% 0%,rgba(255,255,255,.22),transparent 60%),linear-gradient(160deg,#6002ab,#370063)' : ''}`}
        >
          <span class:list={['font-display text-6xl font-extrabold leading-none', i === 1 ? 'text-white' : 'text-volt/90']}>{n}</span>
          <h3 class="mt-6 text-3xl">{title}</h3>
          <p class:list={['mt-3 text-[15px] leading-relaxed', i === 1 ? 'font-medium text-white/80' : 'text-mute']}>{text}</p>
        </li>
      ))
    }
  </ol>
</section>

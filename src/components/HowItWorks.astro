---
import { ui, type Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = ui[lang].how;
const photos = ['escanea', 'registro', 'cobro', 'cliente'];
---

<section id="como-funciona" class="hm-sec">
  <div class="hm-wrap">
    <header class="hm-head reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="h2">{t.h2}</h2>
    </header>
    <ol class="hm-steps">
      {
        t.steps.map(([title, line, alt], i) => (
          <li class="hm-step reveal" style={`--d:${i * 0.08}s`}>
            <img src={`/img/photos/${photos[i]}.webp`} alt={alt} width="720" height="720" loading="lazy" decoding="async" />
            <div class="hm-step-t">
              <span class="hm-num">{i + 1}</span>
              <h3>{title}</h3>
              <p>{line}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

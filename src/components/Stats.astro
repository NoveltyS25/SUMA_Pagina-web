---
// Cifras del producto (solo datos reales de la propuesta).
import { ui, type Lang } from '../i18n/ui';
interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const stats = ui[lang].stats;
---

<section class="relative mx-auto max-w-7xl px-4 sm:px-6">
  <div class="reveal panel panel-glow grid grid-cols-2 gap-y-8 px-6 py-8 sm:px-10 lg:grid-cols-4">
    {
      stats.map(([n, l], i) => (
        <div class:list={['text-center', i > 0 && 'lg:border-l lg:border-white/10']}>
          <p class="font-display text-6xl font-extrabold leading-none text-volt drop-shadow-[0_0_24px_rgba(197,139,255,0.55)] sm:text-7xl">
            {n}
          </p>
          <p class="mt-2 text-sm text-mute">{l}</p>
        </div>
      ))
    }
  </div>
</section>

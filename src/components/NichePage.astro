---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Mark from './Mark.astro';
import { SITE_URL, PRICE_MONTH, wa } from '../lib/site';
import { niches, type Niche } from '../lib/niches';

interface Props {
  niche: Niche;
}
const { niche: n } = Astro.props;

const WA_NICHE = wa(n.waMessage);
const price = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 })
  .format(PRICE_MONTH)
  .replace(/^\$\s/, '$');
const faqs = n.faqs.map((f) => ({ q: f.q, a: f.a.replace('{price}', price) }));
const others = niches.filter((o) => o.slug !== n.slug);

const stepPhotos: [string, string][] = [
  ['foto-escanea-qr-tarjeta-fidelizacion-digital.webp', 'Cliente escaneando con su celular el QR de la tarjeta de fidelización digital'],
  ['foto-registro-cliente-tarjeta-fidelizacion-digital.webp', 'Clienta registrándose en su celular para recibir la tarjeta de sellos digital'],
  ['foto-cobro-en-caja-tarjeta-sellos-digital.webp', 'Dueño de un negocio cobrando en su caja sin cambiar su forma de cobrar'],
];

const jsonLdExtra = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: n.title,
    description: n.description,
    url: `${SITE_URL}${n.path}`,
    inLanguage: 'es-CO',
    about: `Tarjeta de fidelización digital ${n.h1Accent}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: `Para ${n.plural}`, item: `${SITE_URL}${n.path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout title={n.title} description={n.description} jsonLdExtra={jsonLdExtra} withFaq={false}>
  <Header />
  <main class="relative">
    <!-- Portada -->
    <section id="portada" class="relative overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute -right-40 top-0 h-[560px] w-[560px] rounded-full bg-royal/50 blur-[140px]"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 pb-20 pt-12 sm:px-6 lg:grid-cols-2 lg:pb-28 lg:pt-16">
        <div>
          <nav aria-label="Ruta" class="text-sm text-mute">
            <a class="hover:text-bone" href="/">Inicio</a> <span aria-hidden="true">/</span> Para {n.plural}
          </nav>
          <p class="eyebrow mb-4 mt-6">Para {n.plural}</p>
          <h1 class="text-[3.4rem] sm:text-[5rem] lg:text-[5.6rem]">
            Tarjeta de fidelización digital <span class="text-volt">{n.h1Accent}</span>
          </h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-mute sm:text-xl">{n.lead}</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href={WA_NICHE} target="_blank" rel="noopener" class="btn btn-volt">Quiero SUMA en mi negocio</a>
            <a href="/#precios" class="btn btn-ghost">Ver precios</a>
          </div>
        </div>
        <figure class="relative overflow-hidden rounded-3xl border border-white/10">
          <img
            src="/img/foto-mostrador-cafe-tarjeta-fidelizacion-digital.webp"
            alt={n.heroAlt}
            width="1200"
            height="1200"
            fetchpriority="high"
            class="aspect-[4/3] w-full object-cover object-[50%_45%]"
          />
        </figure>
      </div>
    </section>

    <!-- Problema -->
    <section id="problema" class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <div class="reveal max-w-3xl">
        <p class="eyebrow mb-4">El problema</p>
        <h2 class="h2">El cartón de sellos <span class="text-volt">no le sirve a tu negocio.</span></h2>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {
          n.pains.map(([t, d]) => (
            <article class="reveal panel p-7">
              <h3 class="text-3xl">{t}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-mute">{d}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Cómo funciona -->
    <section id="como-funciona" class="mx-auto max-w-7xl px-4 pb-20 sm:px-6">
      <div class="reveal max-w-3xl">
        <p class="eyebrow mb-4">Cómo funciona</p>
        <h2 class="h2">Tres pasos en tu local</h2>
      </div>
      <ol class="mt-12 grid gap-4 md:grid-cols-3">
        {
          n.steps.map(([t, d], i) => (
            <li class="reveal panel overflow-hidden">
              <img src={`/img/${stepPhotos[i][0]}`} alt={stepPhotos[i][1]} width="1200" height="1200" loading="lazy" class="aspect-[4/3] w-full object-cover" />
              <div class="p-6">
                <span class="font-display text-5xl font-extrabold leading-none text-volt/90">0{i + 1}</span>
                <h3 class="mt-3 text-3xl">{t}</h3>
                <p class="mt-2 text-[15px] text-mute">{d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Ideas -->
    <section id="ideas" class="relative overflow-hidden border-t border-white/10 bg-black/20">
      <Mark kind="arch" class="pointer-events-none absolute -right-24 top-10 w-[460px] text-forest/30" />
      <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6">
        <div class="reveal max-w-3xl">
          <p class="eyebrow mb-4">Qué puedes hacer</p>
          <h2 class="h2">{n.ideasTitle}</h2>
        </div>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            n.ideas.map(([t, d]) => (
              <article class="reveal panel p-6">
                <h3 class="text-2xl normal-case leading-tight">
                  <span class="mr-2 text-volt" aria-hidden="true">✓</span>{t}
                </h3>
                <p class="mt-2 text-[15px] leading-relaxed text-mute">{d}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Caso real (solo cafeterías) -->
    {
      n.cupaCase && (
        <section id="caso" class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
          <div class="reveal panel panel-glow grid items-center gap-10 p-8 sm:p-12 lg:grid-cols-[0.9fr_1.1fr]">
            <div class="relative mx-auto flex items-end justify-center">
              <img
                src="/img/cupa-qr-impreso-tarjeta-fidelizacion-digital.webp"
                alt="Atril de Cupá Pastry & Coffee con el QR para inscribirse en la tarjeta de sellos digital"
                width="550"
                height="860"
                loading="lazy"
                class="w-[210px] -rotate-3 drop-shadow-[0_30px_40px_rgba(0,0,0,0.5)] sm:w-[250px]"
              />
              <img
                src="/img/tarjeta-sellos-digital-cupa-apple-wallet.webp"
                alt="Tarjeta de sellos digital de Cupá Pastry & Coffee en Apple Wallet"
                width="536"
                height="750"
                loading="lazy"
                class="-ml-10 mb-6 w-[170px] rotate-3 drop-shadow-[0_30px_40px_rgba(0,0,0,0.5)] sm:w-[200px]"
              />
            </div>
            <div>
              <p class="eyebrow mb-3">Una cafetería real</p>
              <h2 class="text-5xl sm:text-6xl">
                <a href="https://www.instagram.com/reel/Dex1CfNu0pJ/" target="_blank" rel="noopener" class="hover:text-volt">
                  Cupá Pastry &amp; Coffee
                </a>
              </h2>
              <p class="mt-5 max-w-xl text-lg leading-relaxed text-mute">
                Cupá fue el primer negocio en usar SUMA. Su tarjeta tiene 10 sellos con regalo al final y categorías de clientes,
                todo diseñado con su marca. En el mostrador, un atril con QR para que se inscriban en segundos.
              </p>
              <a href="https://www.instagram.com/reel/Dex1CfNu0pJ/" target="_blank" rel="noopener" class="btn btn-ghost mt-7">
                Ver el video de Cupá en Instagram
              </a>
            </div>
          </div>
        </section>
      )
    }

    <!-- Precio -->
    <section id="precio" class="mx-auto max-w-4xl px-4 pb-20 text-center sm:px-6">
      <div class="reveal">
        <p class="eyebrow mb-3">Precio</p>
        <p class="font-display text-7xl font-extrabold leading-none sm:text-8xl">{price}<span class="text-3xl text-mute"> / mes por sede</span></p>
        <p class="mx-auto mt-5 max-w-xl text-lg text-mute">
          Tarjetas, sellos y clientes ilimitados, con tu diseño y sin costo de montaje.
        </p>
        <a href="/#precios" class="btn btn-ghost mt-7">Ver todo lo que incluye</a>
      </div>
    </section>

    <!-- Preguntas -->
    <section id="preguntas" class="mx-auto max-w-4xl px-4 pb-20 sm:px-6">
      <div class="reveal">
        <p class="eyebrow mb-4">Preguntas</p>
        <h2 class="h2">Lo que preguntan los {n.plural === 'cafeterías' ? 'cafeteros' : 'dueños'}</h2>
      </div>
      <div class="mt-12 divide-y divide-white/10 border-y border-white/10">
        {
          faqs.map((f) => (
            <details name="faq" class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-2xl text-volt transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 max-w-3xl leading-relaxed text-mute">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- Otros negocios -->
    <section id="otros" class="mx-auto max-w-4xl px-4 pb-20 sm:px-6">
      <p class="text-center text-sm text-mute">SUMA también funciona para</p>
      <ul class="mt-4 flex flex-wrap justify-center gap-2">
        {
          others.map((o) => (
            <li>
              <a href={o.path} class="rounded-full border border-volt/40 bg-volt/10 px-4 py-1.5 text-sm font-semibold hover:text-volt">
                {o.label} →
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Cierre -->
    <section id="cierre" class="px-4 pb-24 sm:px-6">
      <div
        class="reveal relative mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] bg-royal px-6 py-16 text-center text-bone sm:px-12 sm:py-24"
        style="background-image:radial-gradient(500px 400px at 0% 0%,rgba(255,255,255,.22),transparent 60%),linear-gradient(160deg,#6002ab,#370063)"
      >
        <h2 class="mx-auto max-w-3xl text-6xl sm:text-8xl">{n.closingTitle}</h2>
        <p class="mx-auto mt-6 max-w-xl text-lg font-medium">{n.closingSub}</p>
        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <a href={WA_NICHE} target="_blank" rel="noopener" class="btn bg-ink text-volt hover:-translate-y-0.5">Escribir por WhatsApp</a>
          <a href="/como-fidelizar-clientes" class="btn border border-white/30 text-bone hover:bg-ink hover:text-volt">Leer la guía de fidelización</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

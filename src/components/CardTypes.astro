---
import Mark from './Mark.astro';
import { ui, type Lang } from '../i18n/ui';
interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = ui[lang].cardTypes;
---

<section id="tarjetas" class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:py-32">
  <Mark kind="arch" class="pointer-events-none absolute -left-24 top-10 hidden w-80 text-white/[0.04] md:block" />
  <div class="reveal max-w-3xl">
    <p class="eyebrow mb-4">{t.eyebrow}</p>
    <h2 class="h2">{t.h2[0]}<span class="text-volt">{t.h2[1]}</span>{t.h2[2]}</h2>
    <p class="mt-5 max-w-xl text-lg text-mute">{t.sub}</p>
  </div>

  <div class="mt-14 grid gap-5 lg:grid-cols-2">
    {
      t.cards.map((c, i) => (
        <article
          class:list={[
            'reveal overflow-hidden',
            i === 1
              ? 'relative rounded-3xl text-bone shadow-[0_30px_80px_-30px_rgba(197,139,255,0.45)]'
              : 'panel panel-glow panel-green',
          ]}
          style={i === 1 ? 'background-image:radial-gradient(500px 400px at 0% 0%,rgba(255,255,255,.22),transparent 60%),linear-gradient(160deg,#6002ab,#370063)' : ''}
        >
          {i === 1 && <Mark kind="pin" class="pointer-events-none absolute -right-8 -top-8 h-40 rotate-[16deg] text-white/10" />}
          <div class:list={['flex h-72 items-center justify-center sm:h-80', i === 0 && 'bg-ink']}>
            <img
              src={`/img/${c.img}`}
              alt={c.imgAlt}
              width={i === 0 ? '738' : '1200'}
              height={i === 0 ? '965' : '750'}
              loading="lazy"
              class:list={i === 0 ? 'h-full w-auto rounded-2xl object-contain' : 'h-full w-full object-cover'}
            />
          </div>
          <div class="flex flex-col p-8 sm:p-10">
            <span class:list={['font-display text-sm font-bold uppercase tracking-wider', i === 1 ? 'text-white/70' : 'text-volt']}>{c.tag}</span>
            <h3 class="mt-3 text-4xl sm:text-5xl">{c.title}</h3>
            <p class:list={['mt-4 text-[15px] leading-relaxed', i === 1 ? 'text-white/85' : 'text-mute']}>{c.text}</p>
            <ul class="mt-6 space-y-3 text-[15px]">
              {
                c.bullets.map((b) => (
                  <li class="flex gap-3">
                    <span class="mt-0.5 text-volt" aria-hidden="true">✓</span>
                    {b}
                  </li>
                ))
              }
            </ul>
          </div>
        </article>
      ))
    }
  </div>

  <div class="reveal mt-10 text-center">
    <a href="#precios" class="btn btn-ghost">{t.cta} →</a>
  </div>
</section>

---
import { ui, type Lang } from '../i18n/ui';
import { homeLink } from '../lib/i18n';
import WalletCard from './WalletCard.astro';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = ui[lang].cardTypes;
const bizs = ['cupa', 'elr'] as const;
---

<section id="tarjetas" class="hm-sec">
  <div class="hm-wrap">
    <header class="hm-head reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="h2">{t.h2}</h2>
    </header>
    <div class="hm-types">
      {
        t.cards.map((c, i) => (
          <article class="hm-type reveal" style={`--d:${i * 0.1}s`}>
            <div class="hm-type-card">
              <WalletCard biz={bizs[i]!} lang={lang} />
            </div>
            <div class="hm-type-t">
              <p class="eyebrow">{c.tag}</p>
              <h3>{c.title}</h3>
              <p class="hm-lead">{c.text}</p>
              <ul>{c.bullets.map((b) => <li>{b}</li>)}</ul>
            </div>
          </article>
        ))
      }
    </div>
    <p class="hm-center reveal"><a href={homeLink(lang, '#precios')} class="btn btn-volt">{t.cta}</a></p>
  </div>
</section>

---
import { waLinks, WA_DISPLAY, CONTACT_EMAIL } from '../lib/site';
import { ui, type Lang } from '../i18n/ui';
import { homeLink } from '../lib/i18n';
import Mark from './Mark.astro';
import { niches } from '../lib/niches';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = ui[lang].footer;
const WA_CONTACT = waLinks(lang).contact;
---

<footer class="relative overflow-hidden border-t border-white/10">
  <Mark kind="arch" class="pointer-events-none absolute -right-10 -top-6 w-72 text-white/[0.04]" />
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-12 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div>
      <img src="/logos/suma-blanco.png" alt="SUMA" width="120" height="68" class="h-9 w-auto" loading="lazy" />
      <p class="mt-3 text-sm text-mute">{t.tagline}</p>
    </div>
    <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-mute" aria-label={t.navAria}>
      {t.nav.map(([label, hash]) => <a class="hover:text-bone" href={homeLink(lang, hash)}>{label}</a>)}
      <a class="hover:text-bone" href="/como-fidelizar-clientes">{t.guide}</a>
      {lang === 'es' && <a class="hover:text-bone" href="/quienes-somos">Quiénes somos</a>}
      <a class="hover:text-bone" href="/politica-de-datos">{t.privacy}</a>
      <a class="hover:text-bone" href="/terminos-y-condiciones">{t.terms}</a>
      <a class="text-volt hover:underline" href={WA_CONTACT} target="_blank" rel="noopener">
        {t.whatsapp} {WA_DISPLAY}
      </a>
      <a class="text-volt hover:underline" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </nav>
  </div>
  {
    lang === 'es' && (
      <nav aria-label="Para tu negocio" class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 pb-8 text-sm text-mute sm:px-6">
        <span class="font-semibold text-bone/70">Para tu negocio:</span>
        {niches.map((o) => <a class="hover:text-bone" href={o.path}>{o.label}</a>)}
        <a class="hover:text-bone" href="/tarjeta-de-sellos-digital-vs-carton">Digital vs. cartón</a>
      </nav>
    )
  }
  <p class="mx-auto max-w-4xl border-t border-white/5 px-4 pt-5 text-center text-xs leading-relaxed text-mute/80">{t.coverage}</p>
  <p class="py-5 text-center text-xs text-mute">
    © {new Date().getFullYear()} SUMA. {t.rights}
  </p>
</footer>

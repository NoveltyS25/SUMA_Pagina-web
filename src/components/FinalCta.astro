---
import { waLinks } from '../lib/site';
import { ui, type Lang } from '../i18n/ui';
import Mark from './Mark.astro';
import Sparkle from './Sparkle.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = ui[lang].cta;
const { contact: WA_CONTACT, demo: WA_DEMO } = waLinks(lang);
---

<section class="px-4 pb-24 sm:px-6">
  <div class="reveal relative mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] bg-royal px-6 py-20 text-center text-bone shadow-[0_40px_100px_-30px_rgba(197,139,255,0.4)] sm:px-12 sm:py-28" style="background-image:radial-gradient(500px 400px at 0% 0%,rgba(255,255,255,.22),transparent 60%),linear-gradient(160deg,#6002ab,#370063)">
    <Sparkle class="twinkle pointer-events-none absolute left-[12%] top-14 size-8 text-white/40" />
    <Sparkle class="twinkle pointer-events-none absolute bottom-16 right-[14%] size-10 text-white/60" />
    <Mark kind="arch" class="pointer-events-none absolute -bottom-10 -left-16 w-[420px] text-white/10" />
    <Mark kind="pin" class="pointer-events-none absolute -right-6 -top-8 hidden h-72 rotate-[16deg] text-white/10 sm:block" />
    <h2 class="mx-auto max-w-4xl text-6xl sm:text-8xl lg:text-9xl">{t.h2}</h2>
    <p class="mx-auto mt-6 max-w-xl text-lg font-medium">
      {t.text}
    </p>
    <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
      <a href={WA_DEMO} target="_blank" rel="noopener" class="btn bg-ink text-volt hover:-translate-y-0.5">
        {t.demo}
      </a>
      <a href={WA_CONTACT} target="_blank" rel="noopener" class="btn border border-white/30 text-bone hover:bg-ink hover:text-volt">
        {t.wa}
      </a>
    </div>
  </div>
</section>

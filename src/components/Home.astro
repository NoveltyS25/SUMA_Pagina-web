---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Clients from './Clients.astro';
import CardTypes from './CardTypes.astro';
import Benefits from './Benefits.astro';
import HowItWorks from './HowItWorks.astro';
import Pricing from './Pricing.astro';
import Trail from './Trail.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Layout lang={lang} alternates autoLang={lang === 'es'}>
  <Header lang={lang} />
  <main class="relative">
    <Trail />
    <Hero lang={lang} />
    <Clients lang={lang} />
    <CardTypes lang={lang} />
    <Benefits lang={lang} />
    <HowItWorks lang={lang} />
    <Pricing lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

---
import { ui, type Lang } from '../i18n/ui';
interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = ui[lang].clients;
---

<section class="border-y border-white/10 bg-black/20 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="reveal text-center">
      <p class="eyebrow mb-3">{t.eyebrow}</p>
      <h2 class="h2">{t.h2[0]}<span class="text-volt">{t.h2[1]}</span>{t.h2[2]}</h2>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        t.items.map((c, i) => (
          <div
            class:list={[
              'reveal panel panel-glow flex flex-col items-center gap-4 p-8 text-center',
              i === 2 && 'sm:col-span-2 sm:mx-auto sm:w-full sm:max-w-[calc(50%-0.625rem)]',
            ]}
          >
            {c.logo ? (
              <span class="block size-20 overflow-hidden rounded-full">
                <img src={c.logo} alt={c.name} width="200" height="200" loading="lazy" class="h-full w-full scale-[1.08] object-cover" />
              </span>
            ) : (
              <span class="flex h-20 items-center font-display text-3xl font-bold uppercase tracking-wide text-bone">{c.name}</span>
            )}
            {c.logo && <p class="font-display text-sm font-semibold uppercase tracking-wider text-mute">{c.name}</p>}
            <div class="flex h-64 w-full items-center justify-center overflow-hidden rounded-2xl bg-ink">
              <img src={c.card} alt={c.cardAlt} width="738" height="965" loading="lazy" class="h-full w-auto rounded-2xl object-contain" />
            </div>
            {c.href ? (
              <a href={c.href} target="_blank" rel="noopener" class="text-sm font-semibold text-volt hover:underline">
                {t.videoLabel} →
              </a>
            ) : (
              <span class="text-sm text-mute/60">{t.comingSoon}</span>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

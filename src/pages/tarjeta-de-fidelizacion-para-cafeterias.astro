---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Mark from '../components/Mark.astro';
import { SITE_URL, PRICE_MONTH, wa } from '../lib/site';

const path = '/tarjeta-de-fidelizacion-para-cafeterias';
const title = 'Tarjeta de fidelización digital para cafeterías | SUMA';
const description =
  'Tarjeta de sellos digital para cafeterías: tus clientes la guardan en Apple o Google Wallet, sin apps, y suma sola desde tu caja. Sabe quién vuelve.';

const WA_CAFE = wa('Hola, tengo una cafetería y quiero saber más sobre SUMA.');
const price = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 })
  .format(PRICE_MONTH)
  .replace(/^\$\s/, '$');

const pains = [
  ['Se pierde o se olvida', 'El cartón se queda en la otra chaqueta y el café de regalo nunca llega.'],
  ['No sabes quién es tu cliente', 'Un sello en papel no te dice cuántas veces vuelve ni cuánto gasta.'],
  ['No hay cómo avisarles', 'Lanzas el postre nuevo y dependes de que vean tu Instagram.'],
];

const steps = [
  ['01', 'Pega el QR', 'En el mostrador o en las mesas.', 'foto-escanea-qr-tarjeta-fidelizacion-digital.webp', 'Cliente escaneando con su celular el QR de la tarjeta de fidelización en la mesa de una cafetería'],
  ['02', 'Se inscriben', 'Toma unos 30 segundos.', 'foto-registro-cliente-tarjeta-fidelizacion-digital.webp', 'Clienta registrándose en su celular para recibir la tarjeta de sellos digital'],
  ['03', 'Cada café suma', 'Cobras igual y el sello llega solo.', 'foto-cobro-en-caja-tarjeta-sellos-digital.webp', 'Dueño de un negocio cobrando en su caja sin cambiar su forma de cobrar'],
];

const ideas = [
  ['10 sellos, café de regalo', 'La meta clásica. La cantidad la defines tú.'],
  ['Categorías de clientes', 'Quien más viene sube de nivel y recibe algo más.'],
  ['Sello doble en horas flojas', 'Llena la tarde del martes sin bajar precios.'],
  ['Aviso de promos', 'Anuncia el pastel del día o el happy hour directo al celular.'],
  ['Aviso a quien no vuelve', 'Escríbele a quien lleva días sin pasar por tu café.'],
  ['Cumpleaños y fechas', 'Un detalle en el día justo vale más que un descuento al azar.'],
];

const faqs = [
  {
    q: '¿Cuántos sellos debe tener la tarjeta de una cafetería?',
    a: 'Muchas cafeterías empiezan con 10 sellos para un café gratis, pero la cantidad la defines tú. Con los datos de visitas puedes acortarla o alargarla.',
  },
  {
    q: '¿Mis clientes necesitan descargar una app?',
    a: 'No. La tarjeta vive en el Wallet que ya trae su celular. Escanean el QR, se inscriben en unos 30 segundos y la guardan.',
  },
  {
    q: '¿Tengo que cambiar mi caja?',
    a: 'No. SUMA se conecta a tu caja actual. Tu equipo cobra como siempre y pide la cédula del cliente.',
  },
  {
    q: '¿Cuánto cuesta para una cafetería?',
    a: `La membresía es de ${price} al mes por sede, con tarjetas, sellos y clientes ilimitados. Cada sede adicional suma $30.000 al mes. La suscripción es a 12 meses.`,
  },
];

const jsonLdExtra = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: `${SITE_URL}${path}`,
    inLanguage: 'es-CO',
    about: 'Tarjeta de fidelización digital para cafeterías',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Para cafeterías', item: `${SITE_URL}${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout title={title} description={description} jsonLdExtra={jsonLdExtra} withFaq={false}>
  <Header />
  <main class="relative">
    <!-- Portada -->
    <section class="relative overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute -right-40 top-0 h-[560px] w-[560px] rounded-full bg-royal/50 blur-[140px]"></div>
      <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 pb-20 pt-12 sm:px-6 lg:grid-cols-2 lg:pb-28 lg:pt-16">
        <div>
          <nav aria-label="Ruta" class="text-sm text-mute">
            <a class="hover:text-bone" href="/">Inicio</a> <span aria-hidden="true">/</span> Para cafeterías
          </nav>
          <p class="eyebrow mb-4 mt-6">Para cafeterías</p>
          <h1 class="text-[3.4rem] sm:text-[5rem] lg:text-[5.6rem]">
            Tarjeta de fidelización digital <span class="text-volt">para cafeterías</span>
          </h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-mute sm:text-xl">
            Una tarjeta de sellos en el Apple Wallet y el Google Wallet de tus clientes. Cada café suma,
            el décimo es de regalo y tú sabes quién vuelve. Sin apps y conectada a tu caja.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href={WA_CAFE} target="_blank" rel="noopener" class="btn btn-volt">Quiero SUMA en mi cafetería</a>
            <a href="/#precios" class="btn btn-ghost">Ver precios</a>
          </div>
        </div>
        <figure class="relative overflow-hidden rounded-3xl border border-white/10">
          <img
            src="/img/foto-mostrador-cafe-tarjeta-fidelizacion-digital.webp"
            alt="Dueño de una cafetería y dos clientes con la tarjeta de sellos digital en el celular"
            width="1200"
            height="1200"
            fetchpriority="high"
            class="aspect-[4/3] w-full object-cover object-[50%_45%]"
          />
        </figure>
      </div>
    </section>

    <!-- Problema -->
    <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <div class="reveal max-w-3xl">
        <p class="eyebrow mb-4">El problema</p>
        <h2 class="h2">El cartón de sellos <span class="text-volt">no le sirve a tu cafetería.</span></h2>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {
          pains.map(([t, d]) => (
            <article class="reveal panel p-7">
              <h3 class="text-3xl">{t}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-mute">{d}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Cómo funciona -->
    <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6">
      <div class="reveal max-w-3xl">
        <p class="eyebrow mb-4">Cómo funciona</p>
        <h2 class="h2">Tres pasos en tu mostrador</h2>
      </div>
      <ol class="mt-12 grid gap-4 md:grid-cols-3">
        {
          steps.map(([n, t, d, img, alt]) => (
            <li class="reveal panel overflow-hidden">
              <img src={`/img/${img}`} alt={alt} width="1200" height="1200" loading="lazy" class="aspect-[4/3] w-full object-cover" />
              <div class="p-6">
                <span class="font-display text-5xl font-extrabold leading-none text-volt/90">{n}</span>
                <h3 class="mt-3 text-3xl">{t}</h3>
                <p class="mt-2 text-[15px] text-mute">{d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Ideas -->
    <section class="relative overflow-hidden border-t border-white/10 bg-black/20">
      <Mark kind="arch" class="pointer-events-none absolute -right-24 top-10 w-[460px] text-forest/30" />
      <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6">
        <div class="reveal max-w-3xl">
          <p class="eyebrow mb-4">Qué puedes hacer</p>
          <h2 class="h2">Ideas de fidelización para cafeterías</h2>
        </div>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            ideas.map(([t, d]) => (
              <article class="reveal panel p-6">
                <h3 class="text-2xl normal-case leading-tight">
                  <span class="mr-2 text-volt" aria-hidden="true">✓</span>{t}
                </h3>
                <p class="mt-2 text-[15px] leading-relaxed text-mute">{d}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Caso real -->
    <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <div class="reveal panel panel-glow grid items-center gap-10 p-8 sm:p-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="relative mx-auto flex items-end justify-center">
          <img
            src="/img/cupa-qr-impreso-tarjeta-fidelizacion-digital.webp"
            alt="Atril de Cupá Pastry & Coffee con el QR para inscribirse en la tarjeta de sellos digital"
            width="550"
            height="860"
            loading="lazy"
            class="w-[210px] -rotate-3 drop-shadow-[0_30px_40px_rgba(0,0,0,0.5)] sm:w-[250px]"
          />
          <img
            src="/img/tarjeta-sellos-digital-cupa-apple-wallet.webp"
            alt="Tarjeta de sellos digital de Cupá Pastry & Coffee en Apple Wallet"
            width="536"
            height="750"
            loading="lazy"
            class="-ml-10 mb-6 w-[170px] rotate-3 drop-shadow-[0_30px_40px_rgba(0,0,0,0.5)] sm:w-[200px]"
          />
        </div>
        <div>
          <p class="eyebrow mb-3">Una cafetería real</p>
          <h2 class="text-5xl sm:text-6xl">
            <a href="https://www.instagram.com/reel/Dex1CfNu0pJ/" target="_blank" rel="noopener" class="hover:text-volt">
              Cupá Pastry &amp; Coffee
            </a>
          </h2>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-mute">
            Cupá fue el primer negocio en usar SUMA. Su tarjeta tiene 10 sellos con regalo al final y
            categorías de clientes, todo diseñado con su marca. En el mostrador, un atril con QR para que
            se inscriban en segundos.
          </p>
          <a
            href="https://www.instagram.com/reel/Dex1CfNu0pJ/"
            target="_blank"
            rel="noopener"
            class="btn btn-ghost mt-7"
          >
            Ver el video de Cupá en Instagram
          </a>
        </div>
      </div>
    </section>

    <!-- Precio -->
    <section class="mx-auto max-w-4xl px-4 pb-20 text-center sm:px-6">
      <div class="reveal">
        <p class="eyebrow mb-3">Precio</p>
        <p class="font-display text-7xl font-extrabold leading-none sm:text-8xl">{price}<span class="text-3xl text-mute"> / mes por sede</span></p>
        <p class="mx-auto mt-5 max-w-xl text-lg text-mute">
          Tarjetas, sellos y clientes ilimitados, con tu diseño y sin costo de montaje.
        </p>
        <a href="/#precios" class="btn btn-ghost mt-7">Ver todo lo que incluye</a>
      </div>
    </section>

    <!-- Preguntas -->
    <section class="mx-auto max-w-4xl px-4 pb-24 sm:px-6">
      <div class="reveal">
        <p class="eyebrow mb-4">Preguntas</p>
        <h2 class="h2">Lo que preguntan las cafeterías</h2>
      </div>
      <div class="mt-12 divide-y divide-white/10 border-y border-white/10">
        {
          faqs.map((f) => (
            <details name="faq" class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-2xl text-volt transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 max-w-3xl leading-relaxed text-mute">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- Cierre -->
    <section class="px-4 pb-24 sm:px-6">
      <div
        class="reveal relative mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] bg-royal px-6 py-16 text-center text-bone sm:px-12 sm:py-24"
        style="background-image:radial-gradient(500px 400px at 0% 0%,rgba(255,255,255,.22),transparent 60%),linear-gradient(160deg,#6002ab,#370063)"
      >
        <h2 class="mx-auto max-w-3xl text-6xl sm:text-8xl">Que tus clientes vuelvan por otro café</h2>
        <p class="mx-auto mt-6 max-w-xl text-lg font-medium">Cuéntanos de tu cafetería y te mostramos SUMA funcionando.</p>
        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <a href={WA_CAFE} target="_blank" rel="noopener" class="btn bg-ink text-volt hover:-translate-y-0.5">Escribir por WhatsApp</a>
          <a href="/como-fidelizar-clientes" class="btn border border-white/30 text-bone hover:bg-ink hover:text-volt">Leer la guía de fidelización</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

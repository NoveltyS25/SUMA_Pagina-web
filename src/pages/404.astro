---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Mark from '../components/Mark.astro';
import Sparkle from '../components/Sparkle.astro';
---

<Layout title="Página no encontrada | SUMA" description="Esta página no existe. Vuelve al inicio de SUMA.">
  <Header />
  <main class="px-4 pb-24 pt-12 sm:px-6 lg:pt-20">
    <section
      class="relative mx-auto max-w-5xl overflow-hidden rounded-[2.5rem] bg-royal px-6 py-20 text-center text-bone shadow-[0_40px_100px_-30px_rgba(197,139,255,0.4)] sm:px-12 sm:py-28"
      style="background-image:radial-gradient(500px 400px at 0% 0%,rgba(255,255,255,.22),transparent 60%),linear-gradient(160deg,#6002ab,#370063)"
    >
      <Sparkle class="twinkle pointer-events-none absolute left-[10%] top-12 size-8 text-white/40" />
      <Sparkle class="twinkle pointer-events-none absolute bottom-14 right-[12%] size-10 text-white/60" />
      <Mark kind="arch" class="pointer-events-none absolute -bottom-10 -left-16 w-[380px] text-white/10" />
      <Mark kind="pin" class="pointer-events-none absolute -right-6 -top-8 hidden h-64 rotate-[16deg] text-white/10 sm:block" />

      <p class="eyebrow relative">Error 404</p>
      <h1 class="relative mt-2 text-[8rem] leading-none sm:text-[12rem]">404</h1>
      <p class="relative mx-auto -mt-2 max-w-xl text-2xl font-semibold sm:text-3xl">Este sello no está en la tarjeta</p>
      <p class="relative mx-auto mt-4 max-w-lg text-lg font-medium text-bone/85">
        La página que buscas no existe o se movió. Vuelve al inicio y sigue sumando.
      </p>

      <div class="relative mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn bg-ink text-volt hover:-translate-y-0.5">Volver al inicio</a>
        <a href="/tarjeta-de-fidelizacion-para-cafeterias/" class="btn border border-white/30 text-bone hover:bg-ink hover:text-volt">Tarjeta para cafeterías</a>
        <a href="/como-fidelizar-clientes/" class="btn border border-white/30 text-bone hover:bg-ink hover:text-volt">Cómo fidelizar clientes</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

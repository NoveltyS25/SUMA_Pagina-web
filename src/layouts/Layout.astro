---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { SITE_URL, WA_NUMBER, PRICE_MONTH, CONTACT_EMAIL } from '../lib/site';
import { ui, LANGS, homePath, type Lang } from '../i18n/ui';
import { plain } from '../lib/i18n';

interface Props {
  lang?: Lang;
  /** Portada: declara las versiones en otros idiomas (hreflang). */
  alternates?: boolean;
  /** Solo en la portada en español: manda al visitante a su idioma la primera vez. */
  autoLang?: boolean;
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  jsonLdExtra?: object[];
  withFaq?: boolean;
}

const {
  lang = 'es',
  alternates = false,
  autoLang = false,
  title = ui[lang].meta.title,
  description = ui[lang].meta.description,
  type = 'website',
  jsonLdExtra = [],
  withFaq = true,
} = Astro.props;

const t = ui[lang];

// Zonas donde queremos aparecer en búsquedas locales.
const cities = ['Bogotá', 'Chía', 'Cajicá', 'Zipaquirá', 'Cota', 'Sopó', 'Medellín', 'Cali', 'Barranquilla', 'Cartagena', 'Bucaramanga'];
const areaServed = [
  { '@type': 'Country', name: 'Colombia' },
  { '@type': 'AdministrativeArea', name: 'Sabana de Bogotá' },
  ...cities.map((name) => ({ '@type': 'City', name })),
];
const canonical = new URL(Astro.url.pathname, SITE_URL).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'SUMA',
    url: SITE_URL,
    inLanguage: t.htmlLang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'SUMA',
    url: SITE_URL,
    logo: `${SITE_URL}/logos/suma-negro.png`,
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: `+${WA_NUMBER}`,
      email: CONTACT_EMAIL,
      contactType: 'sales',
      areaServed: 'CO',
      availableLanguage: ['es', 'en', 'pt'],
    },
    areaServed,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SUMA',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Apple Wallet, Google Wallet',
    areaServed,
    description,
    offers: {
      '@type': 'Offer',
      price: PRICE_MONTH,
      priceCurrency: 'COP',
      description: 'Membresía mensual por sede',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.items.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: plain(f.a, lang) },
    })),
  },
]
  .filter((j: any) => withFaq || j['@type'] !== 'FAQPage')
  .concat(jsonLdExtra as any[]);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a012e" />
    <meta name="geo.region" content="CO-DC" />
    <meta name="geo.placename" content="Bogotá, Colombia" />
    <link rel="canonical" href={canonical} />
    {
      alternates ? (
        <>
          {LANGS.map((l) => (
            <link rel="alternate" hreflang={ui[l].htmlLang} href={new URL(homePath(l), SITE_URL).href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL('/', SITE_URL).href} />
        </>
      ) : (
        <link rel="alternate" hreflang={t.htmlLang} href={canonical} />
      )
    }
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:site_name" content="SUMA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/og.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {
      autoLang && (
        <script is:inline>
          {`
          // Primera visita a la portada en español: lleva al visitante a su idioma.
          // Buscadores y bots se quedan donde están. Quien eligió idioma a mano se respeta (suma-lang).
          (function () {
            try {
              if (/bot|crawl|spider|slurp|lighthouse|preview|facebookexternalhit/i.test(navigator.userAgent)) return;
              var saved = localStorage.getItem('suma-lang');
              var to = saved;
              if (!to) {
                var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
                var l = String((navigator.languages && navigator.languages[0]) || navigator.language || 'es').toLowerCase();
                if (tz === 'America/Bogota' || l.indexOf('es') === 0) return;
                to = l.indexOf('pt') === 0 ? 'pt' : 'en';
              }
              if (to === 'en' || to === 'pt') location.replace('/' + to + '/' + location.hash);
            } catch (e) {}
          })();
        `}
        </script>
      )
    }

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9X1NQT72YJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-9X1NQT72YJ');
    </script>

    <meta name="facebook-domain-verification" content="kmp6iliaidayii5o4ro6gm79cdya8i" />

    <!-- Meta Pixel -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1368898578488099');
      fbq('track', 'PageView');
    </script>
  </head>
  <body class="relative min-h-screen overflow-x-hidden font-sans text-bone antialiased">
    <noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=1368898578488099&ev=PageView&noscript=1" /></noscript>
    <slot />
    <script>
      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Montos en la moneda del visitante (aproximado; se factura en COP)
      import('../lib/currency').then((m) => m.applyMoney());

      // Conversiones: clics a WhatsApp y origen de la campaña
      import('../lib/tracking').then((m) => m.initTracking());
    </script>
  </body>
</html>

---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { SITE_URL, WA_NUMBER, faqs, PRICE_MONTH } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  jsonLdExtra?: object[];
  withFaq?: boolean;
}

const {
  title = 'Tarjetas de fidelización digital y sellos en Wallet | SUMA',
  description = 'Tarjetas de fidelización digital con sellos en Apple y Google Wallet, conectadas a tu caja. Sin apps. Tus clientes vuelven más y tú ganas sus datos. Desde $240.000/mes.',
  type = 'website',
  jsonLdExtra = [],
  withFaq = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'SUMA',
    url: SITE_URL,
    inLanguage: 'es-CO',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'SUMA',
    url: SITE_URL,
    logo: `${SITE_URL}/logos/suma-negro.png`,
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: `+${WA_NUMBER}`,
      contactType: 'sales',
      areaServed: 'CO',
      availableLanguage: 'es',
    },
    areaServed: 'CO',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SUMA',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Apple Wallet, Google Wallet',
    description,
    offers: {
      '@type': 'Offer',
      price: PRICE_MONTH,
      priceCurrency: 'COP',
      description: 'Membresía mensual por sede',
    },
  },
  ...jsonLdExtra,
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
].filter((j: any) => withFaq || j['@type'] !== 'FAQPage');
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a012e" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-CO" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="SUMA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SUMA: el cartón de sellos ya murió. Tarjetas de fidelización digital." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/og.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9X1NQT72YJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-9X1NQT72YJ');
    </script>
  </head>
  <body class="relative min-h-screen overflow-x-hidden font-sans text-bone antialiased">
    <slot />
    <script>
      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
